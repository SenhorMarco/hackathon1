# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Featherless (chave fornecida pela organização do hackathon)
FEATHERLESS_API_KEY=
# Opcional: modelo com visão da Featherless. Padrão: moonshotai/Kimi-K2.5
AI_MODEL=moonshotai/Kimi-K2.5

# Supabase > Project Settings > Data API (URL) e API Keys (secret / service_role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth: URL base e chave PUBLICÁVEL (nunca service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
